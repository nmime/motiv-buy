{
  "name": "statistic-shared",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/features/statistic/shared/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/features/statistic/shared",
        "main": "libs/features/statistic/shared/src/index.ts",
        "tsConfig": "libs/features/statistic/shared/tsconfig.lib.json",
        "assets": ["libs/features/statistic/shared/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/features/statistic/shared/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/features/statistic/shared/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["scope:statistic", "type:feature", "layer:shared"]
}
