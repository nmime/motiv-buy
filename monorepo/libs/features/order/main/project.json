{
  "name": "order-main",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/features/order/main/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/features/order/main",
        "main": "libs/features/order/main/src/index.ts",
        "tsConfig": "libs/features/order/main/tsconfig.lib.json",
        "assets": ["libs/features/order/main/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/features/order/main/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/features/order/main/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["scope:order", "type:feature", "layer:main"]
}