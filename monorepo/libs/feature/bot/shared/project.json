{
  "name": "@app/feature-bot-shared",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/feature/bot/shared/src",
  "projectType": "library",
  "tags": [
    "scope:bot",
    "type:feature",
    "layer:shared"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/feature/bot/shared",
        "main": "libs/feature/bot/shared/src/index.ts",
        "tsConfig": "libs/feature/bot/shared/tsconfig.lib.json",
        "assets": [],
        "additionalEntryPoints": [],
        "transformers": [
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {}
          },
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {
              "afterDeclarations": true
            }
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/feature/bot/shared/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/feature/bot/shared/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
