{
  "name": "@app/feature-bot-shared",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/feature/bot/shared/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/feature/bot/shared",
        "main": "libs/feature/bot/shared/src/index.ts",
        "tsConfig": "libs/feature/bot/shared/tsconfig.lib.json",
        "assets": [],
        "additionalEntryPoints": [],
        "transformers": [
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {}
          },
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": { "afterDeclarations": true }
          }
        ]
      }
    }
  }
}
