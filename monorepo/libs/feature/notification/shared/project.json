{
  "name": "@app/feature-notification-shared",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/feature/notification/shared/src",
  "projectType": "library",
  "tags": ["scope:feature", "type:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/feature/notification/shared",
        "tsConfig": "libs/feature/notification/shared/tsconfig.lib.json",
        "main": "libs/feature/notification/shared/src/index.ts",
        "assets": [],
        "transformers": [
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {}
          },
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {
              "afterDeclarations": true
            }
          }
        ]
      }
    }
  }
}
