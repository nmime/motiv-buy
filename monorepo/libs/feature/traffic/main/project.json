{
  "name": "@app/feature-traffic-main",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/feature/traffic/main/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/feature/traffic/main",
        "main": "libs/feature/traffic/main/src/index.ts",
        "tsConfig": "libs/feature/traffic/main/tsconfig.lib.json",
        "assets": ["libs/feature/traffic/main/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/feature/traffic/main/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/feature/traffic/main/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["scope:traffic", "type:feature", "layer:main"]
}
