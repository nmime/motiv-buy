        "main": "libs/common/response/src/index.ts",
        "tsConfig": "libs/common/response/tsconfig.lib.json",
        "assets": [],
        "transformers": [
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {}
          },
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {
              "afterDeclarations": true
            }
          }
        ]
      }
    }
  }
}
