{
  "name": "@app/common-nats",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/common/nats/src",
  "projectType": "library",
  "tags": [
    "scope:common",
    "type:utility"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/common/nats",
        "main": "libs/common/nats/src/index.ts",
        "tsConfig": "libs/common/nats/tsconfig.lib.json",
        "assets": [
          "libs/common/nats/*.md"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/common/nats/jest.config.ts"
      }
    }
  }
}
