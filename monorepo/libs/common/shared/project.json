{
  "name": "@app/common-shared",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/common/shared/src",
  "projectType": "library",
  "tags": [
    "scope:common",
    "type:utility"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/common/shared",
        "tsConfig": "libs/common/shared/tsconfig.lib.json",
        "main": "libs/common/shared/src/index.ts",
        "assets": [],
        "transformers": [
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {}
          },
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {
              "afterDeclarations": true
            }
          }
        ]
      }
    }
  }
}
