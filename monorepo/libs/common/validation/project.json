{
  "name": "@app/common-validation",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/common/validation/src",
  "projectType": "library",
  "tags": [
    "scope:common",
    "type:utility"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/common/validation",
        "main": "libs/common/validation/src/index.ts",
        "tsConfig": "libs/common/validation/tsconfig.lib.json",
        "assets": [],
        "transformers": [
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {}
          },
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {
              "afterDeclarations": true
            }
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "libs/common/validation/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/common/validation/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
