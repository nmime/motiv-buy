{
  "name": "migration-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/migration/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/migration",
        "main": "apps/migration/src/main.ts",
        "tsConfig": "apps/migration/tsconfig.json",
        "assets": []
      },
      "configurations": {
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "inspect": false
        },
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "node -r @swc-node/register apps/migration/src/main.ts",
        "cwd": "{workspaceRoot}",
        "envFile": "{workspaceRoot}/.env"
      },
      "configurations": {
        "development": {
          "command": "node -r @swc-node/register apps/migration/src/main.ts",
          "cwd": "{workspaceRoot}",
          "envFile": "{workspaceRoot}/.env"
        },
        "production": {
          "buildTarget": "migration-cli:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/migration/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/migration/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["type:app", "scope:migration"]
}
