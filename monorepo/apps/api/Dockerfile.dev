# Multi-stage Dockerfile for Development API
FROM node:20-alpine AS base
WORKDIR /app

# Install dependencies needed for development
RUN apk add --no-cache python3 make g++ libc6-compat curl

# Development stage - install all dependencies
FROM base AS development
WORKDIR /app

# Copy package files and install all dependencies
COPY package*.json pnpm-lock.yaml* ./
RUN corepack enable && pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S motiv -u 1001 -G nodejs && \
    chown -R motiv:nodejs /app

# Set environment variables for development
ENV NODE_ENV=development
ENV PORT=3000

# Switch to non-root user
USER motiv

# Expose ports (3000 for app, 9229 for debugging)
EXPOSE 3000 9229

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Start development server with hot reload and debugging
CMD ["npx", "nx", "serve", "api", "--host", "0.0.0.0", "--port", "3000"]