{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2023",
    "useDefineForClassFields": false,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "types": ["node", "jest"],
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@app/common-bull": ["libs/common/bull/src/index.ts"],
      "@app/common-exception": ["libs/common/exception/src/index.ts"],
      "@app/common-health": ["libs/common/health/src/index.ts"],
      "@app/common-intl": ["libs/common/intl/src/index.ts"],
      "@app/common-logger": ["libs/common/logger/src/index.ts"],
      "@app/common-redis": ["libs/common/redis/src/index.ts"],
      "@app/common-response": ["libs/common/response/src/index.ts"],
      "@app/common-shared": ["libs/common/shared/src/index.ts"],
      "@app/common-validation": ["libs/common/validation/src/index.ts"],
      "@app/database": ["libs/database/src/index.ts"],
      "@app/feature-auth-main": ["libs/features/auth/main/src/index.ts"],
      "@app/feature-auth-shared": ["libs/features/auth/shared/src/index.ts"],
      "@app/feature-balance-main": ["libs/features/balance/main/src/index.ts"],
      "@app/feature-balance-shared": ["libs/features/balance/shared/src/index.ts"],
      "@app/feature-statistic-main": ["libs/features/statistic/main/src/index.ts"],
      "@app/feature-statistic-shared": ["libs/features/statistic/shared/src/index.ts"],
      "@app/feature-traffic-main": ["libs/features/traffic/main/src/index.ts"],
      "@app/feature-traffic-shared": ["libs/features/traffic/shared/src/index.ts"],
      "@app/feature-user-main": ["libs/features/user/main/src/index.ts"],
      "@app/feature-user-shared": ["libs/features/user/shared/src/index.ts"],
      "@app/shared-config": ["libs/common/shared/src/index.ts"]
    }
  }
}
