{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2023",
    "useDefineForClassFields": false,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "types": ["node", "jest"],
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmitOnError": false,
    "preserveSymlinks": true,
    "paths": {
      "@app/common-bull": ["dist/libs/common/bull"],
      "@app/common-exception": ["dist/libs/common/exception"],
      "@app/common-health": ["dist/libs/common/health"],
      "@app/common-intl": ["dist/libs/common/intl"],
      "@app/common-logger": ["dist/libs/common/logger"],
      "@app/common-redis": ["dist/libs/common/redis"],
      "@app/common-response": ["dist/libs/common/response"],
      "@app/common-shared": ["dist/libs/common/shared"],
      "@app/common-validation": ["dist/libs/common/validation"],
      "@app/database": ["dist/libs/database"],
      "@app/feature-auth-main": ["dist/libs/feature/auth/main"],
      "@app/feature-auth-shared": ["dist/libs/feature/auth/shared"],
      "@app/feature-balance-main": ["dist/libs/feature/balance/main"],
      "@app/feature-balance-shared": ["dist/libs/feature/balance/shared"],
      "@app/feature-bot-main": ["dist/libs/feature/bot/main"],
      "@app/feature-bot-shared": ["dist/libs/feature/bot/shared"],
      "@app/feature-statistic-main": ["dist/libs/feature/statistic/main"],
      "@app/feature-statistic-shared": ["dist/libs/feature/statistic/shared"],
      "@app/feature-traffic-main": ["dist/libs/feature/traffic/main"],
      "@app/feature-traffic-shared": ["dist/libs/feature/traffic/shared"],
      "@app/feature-user-main": ["dist/libs/feature/user/main"],
      "@app/feature-user-shared": ["dist/libs/feature/user/shared"],
      "@app/shared-config": ["dist/libs/common/shared"]
    }
  }
}
