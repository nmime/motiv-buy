# Motiv-Buy Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# COMMON PROJECT CONFIGURATION
# ==========================================
# Project name and environment prefixes - used throughout Docker configs
# REQUIRED: PROJECT_NAME must be set for Docker Compose to work
PROJECT_NAME=motiv-buy
ENV=development

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api/v1
CORS_ENABLED=true

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=motiv_dev
DB_PASSWORD=your_secure_database_password_here
DB_DATABASE=motiv_buy_development
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false

# Note: For production, use a secure password via DB_PASSWORD environment variable

# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_TOKEN_DEV=your_development_bot_token_from_botfather

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=24h

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=2

# ==========================================
# CACHE CONFIGURATION
# ==========================================
CACHE_ENABLED=true
REDIS_CACHE_PREFIX=mikro-orm-cache:
CACHE_TTL=30
CACHE_DEBUG=false

# ==========================================
# LOGGING & MONITORING
# ==========================================
LOG_LEVEL=debug
GRAFANA_PASSWORD=your_grafana_admin_password

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================
HOT_RELOAD=true
DEBUG_MODE=true

# ==========================================
# DOCKER PORT CONFIGURATION
# ==========================================
# External ports for services (customizable per environment)
DB_PORT_EXTERNAL=5432          # Development: 5432, Production: 5433
REDIS_PORT_EXTERNAL=6379       # Development: 6379, Production: 6380
API_PORT_EXTERNAL=3000         # Development: 3000, Production: 3001
HTTP_PORT=80                   # Production HTTP port
HTTPS_PORT=443                 # Production HTTPS port
PGADMIN_PORT=8080             # pgAdmin web interface
REDIS_COMMANDER_PORT=8081     # Redis Commander web interface
MAILCATCHER_WEB_PORT=1080     # Mailcatcher web interface
MAILCATCHER_SMTP_PORT=1025    # Mailcatcher SMTP port
PROMETHEUS_PORT=9090          # Prometheus web interface
GRAFANA_PORT=3002             # Grafana web interface (production)

# ==========================================
# RATE LIMITING CONFIGURATION
# ==========================================
RATE_LIMIT_MAX=100            # Maximum requests per window
RATE_LIMIT_WINDOW=900000      # Window duration in milliseconds (15 minutes)

# ==========================================
# PRODUCTION DOCKER SETTINGS
# ==========================================
# Database user for production (different from development)
DB_USER=motiv_user
# Used by docker-compose-prod.yml
# SENTRY_DSN=your_sentry_dsn_for_error_tracking