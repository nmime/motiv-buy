{
  "name": "@app/source",
  "version": "0.0.0",
  "author": "@nmime (t.me/nmime)",
  "type": "commonjs",
  "scripts": {
    "build": "nx run-many -t build",
    "build:api": "nx build api",
    "build:bot": "nx build bot",
    "build:migration": "nx build migration",
    "build:libs": "nx run-many -t build --projects='tag:type:utility,tag:type:data,tag:type:feature'",
    "build:apps": "nx run-many -t build --projects=tag:type:app",
    "dev": "nx run-many -t serve --parallel=3",
    "dev:api": "nx serve api",
    "dev:bot": "nx serve bot",
    "dev:migration": "nx serve migration",
    "test": "nx run-many -t test --passWithNoTests",
    "test:apps": "nx run-many -t test --projects=tag:type:app --passWithNoTests",
    "test:libs": "nx run-many -t test --projects='tag:type:utility,tag:type:data,tag:type:feature' --passWithNoTests",
    "test:watch": "nx run-many -t test --watch --passWithNoTests",
    "test:coverage": "nx run-many -t test --coverage --passWithNoTests",
    "test:affected": "nx affected -t test --passWithNoTests",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "lint:affected": "nx affected -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "nx reset",
    "deps:graph": "nx graph",
    "deps:affected": "nx affected:graph",
    "migration:run": "ts-node -r tsconfig-paths/register apps/migration/src/main.ts up",
    "migration:revert": "ts-node -r tsconfig-paths/register apps/migration/src/main.ts down",
    "migration:status": "ts-node -r tsconfig-paths/register apps/migration/src/main.ts status",
    "migration:fresh": "ts-node -r tsconfig-paths/register apps/migration/src/main.ts fresh",
    "migration:create": "ts-node -r tsconfig-paths/register apps/migration/src/main.ts create",
    "migration:prod": "node dist/apps/migration/main.js"
  },
  "private": true,
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
