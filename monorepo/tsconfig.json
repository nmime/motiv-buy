{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2023",
    "useDefineForClassFields": false,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "types": ["node", "jest"],
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@app/common-exception": ["libs/common/exception/src"],
      "@app/common-health": ["libs/common/health/src"],
      "@app/common-nats": ["libs/common/nats/src"],
      "@app/common-intl": ["libs/common/intl/src"],
      "@app/common-logger": ["libs/common/logger/src"],
      "@app/common-redis": ["libs/common/redis/src"],
      "@app/common-response": ["libs/common/response/src"],
      "@app/common-shared": ["libs/common/shared/src"],
      "@app/common-validation": ["libs/common/validation/src"],
      "@app/database": ["libs/database/src"],
      "@app/feature-auth-main": ["libs/feature/auth/main/src"],
      "@app/feature-auth-shared": ["libs/feature/auth/shared/src"],
      "@app/feature-balance-main": ["libs/feature/balance/main/src"],
      "@app/feature-balance-shared": ["libs/feature/balance/shared/src"],
      "@app/feature-bot-main": ["libs/feature/bot/main/src"],
      "@app/feature-bot-shared": ["libs/feature/bot/shared/src"],
      "@app/feature-payment-main": ["libs/feature/payment/main/src"],
      "@app/feature-payment-shared": ["libs/feature/payment/shared/src"],
      "@app/feature-statistic-main": ["libs/feature/statistic/main/src"],
      "@app/feature-statistic-shared": ["libs/feature/statistic/shared/src"],
      "@app/feature-traffic-main": ["libs/feature/traffic/main/src"],
      "@app/feature-traffic-shared": ["libs/feature/traffic/shared/src"],
      "@app/feature-user-main": ["libs/feature/user/main/src"],
      "@app/feature-user-shared": ["libs/feature/user/shared/src"],
      "@app/shared-config": ["libs/common/shared/src"]
    }
  }
}
