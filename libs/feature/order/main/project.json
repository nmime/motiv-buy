{
  "name": "@app/feature-order-main",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/feature/order/main/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/feature/order/main",
        "main": "libs/feature/order/main/src/index.ts",
        "tsConfig": "libs/feature/order/main/tsconfig.lib.json",
        "assets": [],
        "transformers": [
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {}
          },
          {
            "name": "typescript-transform-paths/nx-transformer",
            "options": {
              "afterDeclarations": true
            }
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/feature/order/main/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/feature/order/main/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["scope:order", "type:feature", "layer:main"]
}
