# ==============================================================================
# Production Environment Configuration
# ==============================================================================
#
# DEPLOYMENT GUIDE:
# 1. Copy this file to .env on your production server
# 2. Fill in all required values (marked with REQUIRED)
# 3. Configure CI/CD secrets in GitHub Actions (see CI/CD section below)
#
# NEVER commit .env file to version control!
#
# ==============================================================================

# ==============================================================================
# CI/CD CONFIGURATION GUIDE
# ==============================================================================
#
# GITHUB SECRETS (set in GitHub repo Settings > Secrets > Actions):
# ---------------------------------------------------------------
# - DB_PASSWORD          : Production database password
# - REDIS_PASSWORD       : Production Redis password
# - JWT_SECRET           : JWT signing secret (generate: openssl rand -base64 64)
# - TELEGRAM_BOT_TOKEN   : Production bot token from @BotFather
# - CRYPTO_BOT_API_TOKEN : CryptoPay API token (if using crypto payments)
#
# GITHUB VARIABLES (set in GitHub repo Settings > Variables > Actions):
# ---------------------------------------------------------------------
# - DOCKER_REGISTRY      : ghcr.io (or your registry)
# - DOCKER_IMAGE_PREFIX  : your-org/motiv-buy
# - DOMAIN               : your-domain.com
# - API_DOMAIN           : api.your-domain.com
#
# ==============================================================================

# ==============================================================================
# Node Environment
# ==============================================================================
# HARDCODED: Always 'production' for prod deployments
NODE_ENV=production

# ==============================================================================
# Database Configuration
# ==============================================================================
# HARDCODED: Container name in docker-compose.prod.yml
DB_HOST=postgres

# HARDCODED: Default PostgreSQL port inside container
DB_PORT=5432

# HARDCODED: Database name (can be customized per environment)
DB_NAME=motiv_buy_prod

# HARDCODED: Database user (can be customized per environment)
DB_USER=motiv_buy_user

# REQUIRED - CI/CD SECRET: Strong password (min 32 chars)
# Set as: GitHub Secret -> DB_PASSWORD
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN

# ==============================================================================
# Redis Configuration
# ==============================================================================
# HARDCODED: Container name in docker-compose.prod.yml
REDIS_HOST=redis

# HARDCODED: Default Redis port inside container
REDIS_PORT=6379

# REQUIRED - CI/CD SECRET: Strong password
# Set as: GitHub Secret -> REDIS_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# HARDCODED: Redis mode for production
REDIS_MODE=default

# HARDCODED: Redis hosts for app connection
REDIS_HOSTS=redis:6379

# ==============================================================================
# Authentication
# ==============================================================================
# REQUIRED - CI/CD SECRET: Generate with: openssl rand -base64 64
# Set as: GitHub Secret -> JWT_SECRET
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_64_CHARS_MIN

# HARDCODED: Token expiration (can be adjusted)
JWT_EXPIRES_IN=7d

# ==============================================================================
# Telegram Bot
# ==============================================================================
# REQUIRED - CI/CD SECRET: Get from @BotFather
# Set as: GitHub Secret -> TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=YOUR_PRODUCTION_TELEGRAM_BOT_TOKEN
BOT_TOKEN=YOUR_PRODUCTION_TELEGRAM_BOT_TOKEN

# OPTIONAL: Channel ID for moderation requests
# TELEGRAM_MODERATION_CHANNEL_ID=-1001234567890

# ==============================================================================
# Payment Providers
# ==============================================================================
# At least one provider should be configured for payments to work

# OPTIONAL - CI/CD SECRET: CryptoBot API token
# Set as: GitHub Secret -> CRYPTO_BOT_API_TOKEN
# CRYPTO_BOT_API_TOKEN=YOUR_PRODUCTION_CRYPTO_BOT_API_TOKEN

# HARDCODED: CryptoBot URLs
# CRYPTO_BOT_API_URL=https://pay.crypt.bot/api
# CRYPTO_BOT_TESTNET=false

# OPTIONAL: Heleket Payment Gateway
# HELEKET_API_TOKEN=YOUR_HELEKET_API_TOKEN
# HELEKET_MERCHANT_ID=YOUR_HELEKET_MERCHANT_ID

# OPTIONAL: YooKassa Payment Gateway
# YOOKASSA_SHOP_ID=YOUR_YOOKASSA_SHOP_ID
# YOOKASSA_SECRET_KEY=YOUR_YOOKASSA_SECRET_KEY

# ==============================================================================
# NATS Configuration
# ==============================================================================
# HARDCODED: Container name and port
NATS_URL=nats://nats:4222
NATS_CLIENT_NAME=motiv-buy-app

# OPTIONAL: NATS authentication (if enabled in nats.conf)
# NATS_USER=prod_user
# NATS_PASSWORD=prod_password

# ==============================================================================
# Docker Registry
# ==============================================================================
# CI/CD VARIABLE: Set in GitHub Variables
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_PREFIX=nmime/motiv-buy
IMAGE_TAG=latest

# ==============================================================================
# Application Server
# ==============================================================================
# HARDCODED: Internal container port
PORT=3000

# HARDCODED: External port mapping (adjust if needed)
API_PORT_EXTERNAL=3000

# ==============================================================================
# Domain Configuration
# ==============================================================================
# CI/CD VARIABLE: Your production domain
DOMAIN=motivbuy.com
API_DOMAIN=api.motivbuy.com

# ==============================================================================
# SSL/TLS Configuration
# ==============================================================================
# REQUIRED: Email for Let's Encrypt notifications
LETSENCRYPT_EMAIL=admin@motivbuy.com

# ==============================================================================
# Logging
# ==============================================================================
# HARDCODED: Production log level (warn or error recommended)
LOG_LEVEL=warn

# ==============================================================================
# Security
# ==============================================================================
# HARDCODED: Enable if behind Cloudflare or reverse proxy
TRUST_PROXY=true

# ==============================================================================
# Monitoring & Alerts (Optional)
# ==============================================================================
# OPTIONAL - CI/CD SECRET: Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn

# OPTIONAL - CI/CD SECRET: Slack webhook for alerts
# SLACK_WEBHOOK=your_slack_webhook_for_alerts

# ==============================================================================
# Currency Rate Providers (Optional)
# ==============================================================================
# OPTIONAL: API keys for additional rate providers
# CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key
# FREECURRENCY_API_KEY=your_freecurrency_api_key
