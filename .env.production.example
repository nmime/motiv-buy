# ==============================================
# Production Environment Configuration Template
# ==============================================
# Copy this file to .env on your VPS
# Fill in with your actual production values
# NEVER commit this file to version control!

# ==============================================
# Node Environment
# ==============================================
NODE_ENV=production

# ==============================================
# Database Configuration (Production)
# ==============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=motiv_buy_prod
DB_USER=motiv_buy_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN

# ==============================================
# Redis Configuration (Production)
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ==============================================
# JWT Authentication (Production)
# ==============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_64_CHARS_MIN
JWT_EXPIRES_IN=7d

# ==============================================
# Telegram Bot (Production)
# ==============================================
TELEGRAM_BOT_TOKEN=YOUR_PRODUCTION_TELEGRAM_BOT_TOKEN

# Telegram Moderation Channel (Optional)
# Channel ID where moderation requests are sent for admin approval
# TELEGRAM_MODERATION_CHANNEL_ID=-1001234567890

# ==============================================
# Payment Providers (Production) - Optional
# ==============================================
# At least one provider should be configured for payments to work

# CryptoBot (Crypto Pay)
CRYPTO_BOT_API_TOKEN=YOUR_PRODUCTION_CRYPTO_BOT_API_TOKEN
# CRYPTO_BOT_API_URL=https://pay.crypt.bot/api (production) or https://testnet-pay.crypt.bot/api (testnet)
# CRYPTO_BOT_TESTNET=false

# Heleket Payment Gateway
# HELEKET_API_TOKEN=YOUR_PRODUCTION_HELEKET_API_TOKEN
# HELEKET_MERCHANT_ID=YOUR_PRODUCTION_HELEKET_MERCHANT_ID
# HELEKET_API_URL=https://api.heleket.com/v1 (default)

# YooKassa Payment Gateway
# YOOKASSA_SHOP_ID=YOUR_PRODUCTION_YOOKASSA_SHOP_ID
# YOOKASSA_SECRET_KEY=YOUR_PRODUCTION_YOOKASSA_SECRET_KEY
# YOOKASSA_API_URL=https://api.yookassa.ru/v3 (default)

# ==============================================
# Docker Registry
# ==============================================
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_PREFIX=nmime/motiv-buy
IMAGE_TAG=latest

# ==============================================
# Logging (Production)
# ==============================================
LOG_LEVEL=warn

# ==============================================
# Domain Configuration
# ==============================================
DOMAIN=motivbuy.com
API_DOMAIN=api.motivbuy.com

# ==============================================
# SSL/TLS Configuration
# ==============================================
# Email for Let's Encrypt notifications
LETSENCRYPT_EMAIL=admin@motivbuy.com

# ==============================================
# Security
# ==============================================
# Enable if behind Cloudflare or other proxy
TRUST_PROXY=true

# ==============================================
# Monitoring & Alerts (Optional)
# ==============================================
# SENTRY_DSN=your_sentry_dsn
# SLACK_WEBHOOK=your_slack_webhook_for_alerts
