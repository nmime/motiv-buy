# Compiled output
/dist
/build
*.tsbuildinfo

# TypeScript compiled files (should not be in source)
**/*.js
**/*.d.ts
**/*.js.map

# But allow config files
!*.config.js
!**/webpack.config.js
!jest.config.js
!jest.preset.js
!eslint.config.js

# Dependencies
node_modules/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

