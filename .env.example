# ==============================================================================
# Development Environment Configuration
# ==============================================================================
# Quick Start:
#   1. Copy this file to .env: cp .env.example .env
#   2. Set your TELEGRAM_BOT_TOKEN (line 62)
#   3. Run: docker compose -f docker-compose.dev.yml up -d
#   4. Start the app: pnpm run dev
#
# All defaults are pre-configured - only TELEGRAM_BOT_TOKEN is required!
# ==============================================================================

# ==============================================================================
# Docker Compose Configuration
# ==============================================================================
NODE_ENV=development
PROJECT_NAME=motiv-buy
ENV=dev
VPS_DEPLOY_PATH=/opt/motiv-buy

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=motiv_buy_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT_EXTERNAL=5432
DB_MIGRATIONS_PATH=apps/migration/src/migration
# DB_DEBUG=false

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_MODE=default
REDIS_HOSTS=localhost:6381
REDIS_PASSWORD=redis_dev_password
REDIS_PORT_EXTERNAL=6381

# ==============================================================================
# Redis Cache Configuration (Optional)
# ==============================================================================
# CACHE_ENABLED=true
# REDIS_CACHE_PREFIX=mikro-orm-cache:
# CACHE_TTL=30
# CACHE_DEBUG=false

# ==============================================================================
# NATS Configuration (JetStream)
# ==============================================================================
NATS_URL=nats://localhost:4222
NATS_CLIENT_NAME=motiv-buy-app
NATS_PORT_EXTERNAL=4222
NATS_MONITOR_PORT=8222
NATS_USER=nats_dev_user
NATS_PASSWORD=nats_dev_password
NATS_TOKEN=nats_dev_token

# ==============================================================================
# Authentication
# ==============================================================================
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# JWT_EXPIRES_IN=1d
# AUTH_CACHE_ENABLED=true
# SKIP_AUTH_IP_CHECK=false
# ALLOWED_IPS=127.0.0.1,::1
# ALLOW_TO_ENTER_TG_IDS=

# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Bot token is configured via TELEGRAM_BOT_TOKEN above
# BOT_USERNAME=
# BOT_DISPLAY_NAME=
# BOT_DESCRIPTION=
# BOT_DEBUG=false
# BOT_VERBOSE=false
# BOT_VERSION=1.0.0

# ==============================================================================
# Bot Session Configuration (Optional)
# ==============================================================================
# BOT_SESSION_TIMEOUT=3600
# BOT_SESSION_CLEANUP_INTERVAL=300
# BOT_MAX_SESSIONS_PER_USER=5

# ==============================================================================
# Bot Rate Limiting (Optional)
# ==============================================================================
# BOT_RATE_LIMIT_ENABLED=true
# BOT_RATE_LIMIT_RPM=30
# BOT_RATE_LIMIT_BURST=5
# BOT_RATE_LIMIT_WINDOW=60

# ==============================================================================
# Bot Logging (Optional)
# ==============================================================================
# BOT_LOG_LEVEL=info
# BOT_LOG_FORMAT=json
# LOG_LEVEL=debug

# ==============================================================================
# API Configuration
# ==============================================================================
API_PORT=5501
API_HOST=0.0.0.0
API_PORT_EXTERNAL=5501
BOT_PORT=5502
BOT_HOST=0.0.0.0
BOT_PORT_EXTERNAL=5502
API_PREFIX=api/v1
CORS_ENABLED=true
# API_URL=
# FRONTEND_URL=
# AUTH_API_PORT=
# AUTH_API_BASE_URL=
# AUTH_API_ENV_NAME=
# IS_DEV=false
# GRACEFUL_SHUTDOWN_ENABLED=false
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=60

# ==============================================================================
# Payment Providers (Optional - configure for payments)
# ==============================================================================
# CryptoBot (@CryptoBot on Telegram)
# Testnet: @CryptoTestnetBot - https://testnet-pay.crypt.bot/
# Mainnet: @CryptoBot - https://pay.crypt.bot/
# CRYPTO_BOT_API_TOKEN=your_crypto_bot_api_token
# CRYPTO_BOT_API_URL=https://testnet-pay.crypt.bot/api
# CRYPTO_BOT_TESTNET=true
# CRYPTO_BOT_UPDATE_STRATEGY=POLLING  # WEBHOOK, POLLING, or HYBRID (default: HYBRID)

# Payment Base Currency (currency for balance storage and display)
# PAYMENT_BASE_CURRENCY=USD  # Options: USD, EUR, RUB (default: USD)

# Payment Polling Configuration
# PAYMENT_POLLING_ENABLED=true
# PAYMENT_POLLING_INTERVAL=30000  # Poll interval in ms (default: 30000)
# PAYMENT_POLLING_BATCH_SIZE=50   # Transactions per batch (default: 50)

# Invoice Expiration (auto-expire unpaid invoices after this time)
# PAYMENT_INVOICE_EXPIRATION=86400  # In seconds (default: 86400 = 24 hours)

# Heleket Payment Gateway
# HELEKET_API_TOKEN=your_heleket_token
# HELEKET_MERCHANT_ID=your_heleket_merchant_id

# YooKassa Payment Gateway
# YOOKASSA_SHOP_ID=your_yookassa_shop_id
# YOOKASSA_SECRET_KEY=your_yookassa_secret_key

# ==============================================================================
# Currency Rate Providers (Optional - for additional rate sources)
# ==============================================================================
# CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key
# FREECURRENCY_API_KEY=your_freecurrency_api_key

# ==============================================================================
# Moderation (Optional)
# ==============================================================================
# TELEGRAM_MODERATION_CHANNEL_ID=-1001234567890

# ==============================================================================
# Monitoring (Optional - for docker-compose monitoring profile)
# ==============================================================================
# GRAFANA_PASSWORD=your_grafana_admin_password
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3002
