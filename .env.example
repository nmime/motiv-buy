# Environment Configuration Example
# Copy this file to .env and update with your values

# Environment
NODE_ENV=development
PROJECT_NAME=motiv-buy
ENV=dev

# Database
DB_NAME=motiv_buy_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT_EXTERNAL=5432

# Redis
REDIS_PASSWORD=redis_dev_password
REDIS_PORT_EXTERNAL=6379

# NATS
NATS_PORT_EXTERNAL=4222
NATS_MONITOR_PORT=8222
NATS_USER=
NATS_PASSWORD=

# Application
PORT=3000
API_PORT_EXTERNAL=3000
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Crypto Bot (get from @CryptoBot)
CRYPTO_BOT_API_TOKEN=your_crypto_bot_token_here

# Optional: Monitoring (only if using --profile monitoring)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_PASSWORD=admin
