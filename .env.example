# ==============================================
# Environment Configuration Template
# ==============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==============================================
# Node Environment
# ==============================================
NODE_ENV=development

# ==============================================
# Application Ports
# ==============================================
API_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==============================================
# Database Configuration
# ==============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=motiv_buy_dev
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ==============================================
# Redis Configuration
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ==============================================
# JWT Authentication
# ==============================================
JWT_SECRET=your_jwt_secret_min_32_chars_change_in_production
JWT_EXPIRES_IN=7d

# ==============================================
# Telegram Bot
# ==============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ==============================================
# Payment Providers (Optional - can be configured via database)
# ==============================================
# At least one provider should be configured for payments to work
# Configure via environment variables OR database metadata

# CryptoBot (Crypto Pay)
CRYPTO_BOT_API_TOKEN=your_crypto_bot_api_token
# CRYPTO_BOT_TESTNET=false

# Heleket Payment Gateway
# HELEKET_API_TOKEN=your_heleket_api_token
# HELEKET_MERCHANT_ID=your_heleket_merchant_id

# YooKassa Payment Gateway
# YOOKASSA_SHOP_ID=your_yookassa_shop_id
# YOOKASSA_SECRET_KEY=your_yookassa_secret_key

# ==============================================
# Docker Registry (for production)
# ==============================================
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_PREFIX=nmime/motiv-buy
IMAGE_TAG=latest

# ==============================================
# Logging
# ==============================================
LOG_LEVEL=info

# ==============================================
# VPS Deployment (used by GitHub Actions)
# ==============================================
# These are set as GitHub Secrets, not in .env
# VPS_HOST=your.vps.ip.address
# VPS_USER=your_vps_user
# VPS_SSH_KEY=your_private_ssh_key
# VPS_DEPLOY_PATH=/opt/motiv-buy
